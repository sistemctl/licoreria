# === PostgreSQL (contenedor / servicio independiente) ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=licoreria_secret
POSTGRES_DB=licoreria_db
POSTGRES_PORT=5432

# URL que usa la APP para conectarse a la BD (cambia el host según el entorno)
# Local con docker-compose.db.yml:
DATABASE_URL=postgresql://postgres:licoreria_secret@localhost:5432/licoreria_db?schema=public
# Dokploy (host interno del servicio de base de datos, ejemplo):
# DATABASE_URL=postgresql://postgres:TU_PASSWORD@nombre-del-servicio-db:5432/licoreria_db?schema=public

# === NextAuth ===
NEXTAUTH_SECRET=genera_un_secreto_largo_y_aleatorio
NEXTAUTH_URL=http://localhost:3000

# === App ===
APP_PORT=3000

# Primera instalación: true. Después: false
RUN_SEED=true
